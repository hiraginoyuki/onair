{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onair.dev/llm-protocol-alpha/0.1.0/vector-manifest.schema.json",
  "title": "LLM Protocol Alpha Conformance Vector Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "coverage_matrix",
    "feature_matrix",
    "vectors"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "protocol_version": {
      "const": "0.1.0"
    },
    "coverage_matrix": {
      "$ref": "#/$defs/coverage_matrix"
    },
    "feature_matrix": {
      "$ref": "#/$defs/feature_matrix"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/vector"
      }
    }
  },
  "$defs": {
    "coverage_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profiles",
        "payload_classes",
        "directions"
      ],
      "properties": {
        "profiles": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "payload_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/payload_class"
          }
        },
        "directions": {
          "const": "all_distinct_pairs"
        }
      }
    },
    "payload_class": {
      "enum": [
        "request",
        "response",
        "error",
        "stream",
        "cache_report"
      ]
    },
    "feature_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_parts",
        "stream_events",
        "opaque_policy"
      ],
      "properties": {
        "content_parts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/content_part_feature"
          }
        },
        "stream_events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stream_event_feature"
          }
        },
        "opaque_policy": {
          "const": "same_profile_only"
        }
      }
    },
    "content_part_feature": {
      "enum": [
        "text",
        "image",
        "document",
        "tool_call",
        "tool_result",
        "reasoning",
        "citation",
        "refusal",
        "opaque"
      ]
    },
    "stream_event_feature": {
      "enum": [
        "request_started",
        "message_started",
        "output_part_started",
        "output_part_ended",
        "text_delta",
        "reasoning_delta",
        "refusal_part",
        "citation_part",
        "tool_call_delta",
        "usage",
        "terminal",
        "error",
        "opaque"
      ]
    },
    "feature_stage": {
      "enum": [
        "source_decode",
        "cross_profile"
      ]
    },
    "feature_disposition": {
      "enum": [
        "preserved",
        "adapted",
        "lossy",
        "unsupported",
        "non_portable"
      ]
    },
    "content_feature_claim": {
      "$ref": "#/$defs/feature_claim_base",
      "properties": {
        "domain": {
          "const": "content_part"
        },
        "feature": {
          "$ref": "#/$defs/content_part_feature"
        }
      }
    },
    "stream_feature_claim": {
      "$ref": "#/$defs/feature_claim_base",
      "properties": {
        "domain": {
          "const": "stream_event"
        },
        "feature": {
          "$ref": "#/$defs/stream_event_feature"
        }
      }
    },
    "feature_claim_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "feature",
        "stage"
      ],
      "properties": {
        "domain": {
          "type": "string"
        },
        "feature": {
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/feature_stage"
        },
        "disposition": {
          "$ref": "#/$defs/feature_disposition"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "const": "cross_profile"
              }
            },
            "required": [
              "stage"
            ]
          },
          "then": {
            "required": [
              "disposition"
            ]
          },
          "else": {
            "not": {
              "required": [
                "disposition"
              ]
            }
          }
        }
      ]
    },
    "coverage_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_class",
        "support"
      ],
      "properties": {
        "payload_class": {
          "$ref": "#/$defs/payload_class"
        },
        "support": {
          "enum": [
            "supported",
            "unsupported"
          ]
        }
      }
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "kind",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]*\\.json$"
        },
        "kind": {
          "enum": [
            "exact_replay",
            "cross_profile_conversion",
            "unsupported",
            "cache_analysis"
          ]
        },
        "status": {
          "enum": [
            "active",
            "reserved_for_phase_3",
            "reserved_for_phase_4",
            "reserved_for_phase_5"
          ]
        },
        "coverage": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/coverage_claim"
          }
        },
        "feature_coverage": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/content_feature_claim"
              },
              {
                "$ref": "#/$defs/stream_feature_claim"
              }
            ]
          }
        }
      }
    }
  }
}
