{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onair.dev/llm-protocol-alpha/0.1.0/ir.schema.json",
  "title": "LLM Protocol Alpha Intermediate Representation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "profile_id",
    "kind",
    "payload"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.1.0"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "request",
        "response",
        "error",
        "stream"
      ]
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "#/$defs/request"
        },
        {
          "$ref": "#/$defs/response"
        },
        {
          "$ref": "#/$defs/error"
        },
        {
          "$ref": "#/$defs/stream"
        }
      ]
    }
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messages"
      ],
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "stream": {
          "type": "boolean"
        },
        "instructions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_part"
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool_definition"
          }
        },
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "output_schema": {
          "$ref": "#/$defs/output_schema"
        },
        "cache_intent": {
          "$ref": "#/$defs/cache_intent"
        },
        "continuation": {
          "$ref": "#/$defs/continuation"
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opaque_extension"
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output",
        "finish_reason"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "output": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "finish_reason": {
          "type": "string"
        },
        "continuation": {
          "$ref": "#/$defs/continuation"
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opaque_extension"
          }
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "content"
      ],
      "properties": {
        "role": {
          "enum": [
            "system",
            "developer",
            "user",
            "assistant",
            "tool"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_part"
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opaque_extension"
          }
        }
      }
    },
    "content_part": {
      "oneOf": [
        {
          "$ref": "#/$defs/text_part"
        },
        {
          "$ref": "#/$defs/asset_part"
        },
        {
          "$ref": "#/$defs/tool_call_part"
        },
        {
          "$ref": "#/$defs/tool_result_part"
        },
        {
          "$ref": "#/$defs/reasoning_part"
        },
        {
          "$ref": "#/$defs/citation_part"
        },
        {
          "$ref": "#/$defs/refusal_part"
        },
        {
          "$ref": "#/$defs/opaque_part"
        }
      ]
    },
    "text_part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "asset_part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "asset"
      ],
      "properties": {
        "type": {
          "enum": [
            "image",
            "document"
          ]
        },
        "asset": {
          "$ref": "#/$defs/asset"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_type",
        "value"
      ],
      "properties": {
        "reference_type": {
          "enum": [
            "url",
            "data",
            "provider_file"
          ]
        },
        "value": {
          "type": "string"
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "tool_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "input_schema"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_schema": {
          "type": "object"
        },
        "strict": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opaque_extension"
          }
        }
      }
    },
    "tool_call_part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "name",
        "arguments"
      ],
      "properties": {
        "type": {
          "const": "tool_call"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "arguments": {},
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opaque_extension"
          }
        }
      }
    },
    "tool_result_part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "tool_call_id",
        "content"
      ],
      "properties": {
        "type": {
          "const": "tool_result"
        },
        "tool_call_id": {
          "type": "string"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_part"
          }
        },
        "is_error": {
          "type": "boolean"
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opaque_extension"
          }
        }
      }
    },
    "reasoning_part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "summary"
      ],
      "properties": {
        "type": {
          "const": "reasoning"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "opaque": {
          "$ref": "#/$defs/opaque_extension"
        }
      }
    },
    "citation_part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "reference"
      ],
      "properties": {
        "type": {
          "const": "citation"
        },
        "reference": {
          "type": "object"
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opaque_extension"
          }
        }
      }
    },
    "refusal_part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "refusal"
        },
        "text": {
          "type": "string"
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opaque_extension"
          }
        }
      }
    },
    "opaque_part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "extension"
      ],
      "properties": {
        "type": {
          "const": "opaque"
        },
        "extension": {
          "$ref": "#/$defs/opaque_extension"
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "top_p": {
          "type": [
            "number",
            "null"
          ]
        },
        "top_k": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "stop_sequences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "enforcement"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema": {
          "type": "object"
        },
        "enforcement": {
          "enum": [
            "required",
            "preferred"
          ]
        }
      }
    },
    "cache_intent": {
      "oneOf": [
        {
          "$ref": "#/$defs/openai_cache_intent"
        },
        {
          "$ref": "#/$defs/anthropic_cache_intent"
        }
      ]
    },
    "openai_cache_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "openai"
        },
        "request_cache_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "retention": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "anthropic_cache_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "breakpoints"
      ],
      "properties": {
        "kind": {
          "const": "anthropic"
        },
        "breakpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cache_breakpoint"
          }
        }
      }
    },
    "cache_breakpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location"
      ],
      "properties": {
        "location": {
          "$ref": "#/$defs/cache_location"
        },
        "ttl": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuing_profile",
        "extension"
      ],
      "properties": {
        "issuing_profile": {
          "type": "string"
        },
        "extension": {
          "$ref": "#/$defs/opaque_extension"
        }
      }
    },
    "opaque_extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuing_profile",
        "namespace",
        "source_location",
        "payload"
      ],
      "properties": {
        "issuing_profile": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "source_location": {
          "$ref": "#/$defs/source_location"
        },
        "payload": {}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "cache_location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "instructions",
            "message",
            "message_part",
            "tool_definition",
            "output_schema",
            "asset",
            "instruction_asset",
            "cache_directive"
          ]
        },
        "part_index": {
          "type": "integer",
          "minimum": 0
        },
        "message_index": {
          "type": "integer",
          "minimum": 0
        },
        "tool_index": {
          "type": "integer",
          "minimum": 0
        },
        "directive_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source_location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "json_pointer",
            "sse_event",
            "header"
          ]
        },
        "pointer": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "event": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "code",
        "message"
      ],
      "properties": {
        "category": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retry_after_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "param": {
          "type": [
            "string",
            "null"
          ]
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opaque_extension"
          }
        }
      }
    },
    "stream_event": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "request_started",
            "message_started",
            "output_part_started",
            "output_part_ended",
            "text_delta",
            "reasoning_delta",
            "refusal_part",
            "citation_part",
            "tool_call_delta",
            "usage",
            "terminal",
            "error",
            "opaque"
          ]
        }
      }
    },
    "stream": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stream_event"
      }
    }
  }
}
