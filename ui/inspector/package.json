{
  "name": "onair-inspector",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "vite build && node scripts/check-artifact.mjs",
    "check:artifact": "node scripts/check-artifact.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run src --environment node",
    "test:browser": "playwright test",
    "measure:browser": "playwright test --config=playwright.measure.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.5.2",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "svelte": "^5.38.7",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.0.0"
  }
}
